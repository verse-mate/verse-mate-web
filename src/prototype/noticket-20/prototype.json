  "flows": [
    {
      "name": "A newcomer starts the program",
      "screens": [
        "gate",
        "lesson",
        "start"
      ],
      "steps": [
        {
          "from": "gate/offer-new",
          "action": "Start the learning program",
          "to": "start/intro"
        },
        {
          "from": "start/intro",
          "action": "Start the program",
          "to": "lesson/video"
        },
        {
          "from": "lesson/video",
          "action": "Mark as done",
          "to": "lesson/done"
        }
      ]
    },
    {
      "name": "Taking a module check",
      "screens": [
        "check",
        "path"
      ],
      "steps": [
        {
          "from": "path/check-open",
          "action": "Take the check",
          "to": "check/open"
        },
        {
          "from": "check/open",
          "action": "Submit answers",
          "to": "check/incomplete"
        },
        {
          "from": "check/failed",
          "action": "Retake the check",
          "to": "check/open"
        }
      ]
    },
    {
      "name": "From the path to the record",
      "screens": [
        "completion",
        "path"
      ],
      "steps": [
        {
          "from": "path/completed-new-module",
          "action": "See your record",
          "to": "completion/request-form"
        }
      ]
    },
    {
      "name": "An admin answers a request",
      "screens": [
        "admin-home"
      ],
      "steps": [
        {
          "from": "admin-home/requests",
          "action": "Approve",
          "to": "admin-home/approve"
        },
        {
          "from": "admin-home/requests",
          "action": "Decline",
          "to": "admin-home/decline"
        }
      ]
    },
    {
      "name": "An admin edits the program",
      "screens": [
        "admin-home",
        "admin-learners",
        "admin-lesson",
        "admin-module",
        "admin-program"
      ],
      "steps": [
        {
          "from": "admin-home/requests",
          "action": "Program",
          "to": "admin-program/modules"
        },
        {
          "from": "admin-program/modules",
          "action": "Teaching craft: shaping the hour",
          "to": "admin-module/edit"
        },
        {
          "from": "admin-module/edit",
          "action": "Reading the passage together",
          "to": "admin-lesson/edit"
        },
        {
          "from": "admin-lesson/edit",
          "action": "Preview as a learner",
          "to": "admin-lesson/draft-preview"
        },
        {
          "from": "admin-program/modules",
          "action": "Learners",
          "to": "admin-learners/list"
        }
      ]
    }
  ],
  "components": [
    {
      "name": "Program shell and shared pieces (top bar with Learning and Program, tags, step marks, progress, dialog, safe Markdown)",
      "file": "src/prototype/noticket-20/ui.tsx"
    },
    {
      "name": "Learner screens: gate, start, path, lesson, check, completion and join request",
      "file": "src/prototype/noticket-20/learner.tsx"
    },
    {
      "name": "Admin screens: join requests, modules, module editor, lesson editor with live preview and video upload, learners",
      "file": "src/prototype/noticket-20/admin.tsx"
    },
    {
      "name": "Admin home: the roster with the Program nav item and the open join requests",
